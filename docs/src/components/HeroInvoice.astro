---
import InvoiceCard from './InvoiceCard.astro';
import NotFoundCard from './NotFoundCard.astro';
import DraftContentNotice from 'virtual:starlight/components/DraftContentNotice';
// Starlight's content-page title anchor (not publicly exported upstream).
const PAGE_TITLE_ID = '_top';
import LinkButton from './LinkButtonCopy.astro';

const { id: entryId, data } = Astro.locals.starlightRoute.entry;
// The homepage entry's id is '' (root locale) or ends in '/index' (others).
const isHomepage = !entryId || entryId === 'index' || entryId.endsWith('/index');
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hero hero-invoice-split">
	<div class="sl-flex stack">
		<div class="sl-flex copy">
			<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
			{data.draft && <DraftContentNotice />}
			{tagline && <div class="tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="sl-flex actions">
					{actions.map(
						({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
							<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
								{text}
								{icon?.html && <Fragment set:html={icon.html} />}
							</LinkButton>
						)
					)}
				</div>
			)
		}
	</div>
	<div class="hero-invoice">
		{isHomepage && <InvoiceCard />}
		{entryId === '404' && <NotFoundCard />}
	</div>
</div>

<style>
	@layer starlight.components {
		.hero-invoice-split {
			display: grid;
			grid-template-columns: 100%;
			align-items: center;
			gap: 2rem;
			padding-bottom: 1rem;
		}

		.hero-invoice-split .stack {
			flex-direction: column;
			gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
			text-align: center;
		}

		.hero-invoice-split .copy {
			flex-direction: column;
			gap: 1rem;
			align-items: center;
		}

		.hero-invoice-split .copy > * {
			max-width: 50ch;
		}

		.hero-invoice-split h1 {
			font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}

		.hero-invoice-split .tagline {
			font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
			color: var(--sl-color-gray-2);
		}

		.hero-invoice-split .actions {
			gap: 1rem 2rem;
			flex-wrap: wrap;
			justify-content: center;
		}

		.hero-invoice {
			min-width: 0;
		}

		@media (min-width: 50rem) {
			.hero-invoice-split {
				grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
				gap: 4%;
				padding-block: clamp(2rem, calc(1rem + 8vmin), 7rem);
			}

			.hero-invoice-split .stack {
				text-align: start;
			}

			.hero-invoice-split .copy {
				align-items: flex-start;
			}

			.hero-invoice-split .actions {
				justify-content: flex-start;
			}
		}
	}
</style>
