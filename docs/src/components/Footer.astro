---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
---

{/* Site footer, then Starlight's own footer (edit link, pagination). */}
{/* A small script moves the site footer below the pagination row. */}
<footer class="site-footer">
	<p class="site-footer-line">
		<a
			href="https://github.com/deshmukhmayur/rto-invoice-prep/blob/main/LICENSE"
			target="_blank"
			rel="noopener noreferrer">License</a
		>
		<span aria-hidden="true">·</span>
		<a
			href="https://github.com/deshmukhmayur/rto-invoice-prep/issues/new?template=bug_report.yml"
			target="_blank"
			rel="noopener noreferrer">Report a bug</a
		>
		<span aria-hidden="true">·</span>
		<a
			href="https://github.com/deshmukhmayur/rto-invoice-prep/issues/new?template=feature_request.yml"
			target="_blank"
			rel="noopener noreferrer">Request a feature</a
		>
		<span class="site-footer-credit">
			<span class="credit-ink">© 2026</span>
			<a href="https://deshmukhmayur.com" target="_blank" rel="noopener noreferrer"
				>Mayur Deshmukh</a
			>
		</span>
	</p>
</footer>
<DefaultFooter />

<script>
	const moveSiteFooterBelowPagination = () => {
		const siteFooter = document.querySelector('footer.site-footer');
		const pagination = document.querySelector('.pagination-links');
		if (!siteFooter || !pagination?.parentElement) return;
		pagination.parentElement.insertBefore(siteFooter, pagination.nextSibling);
	};

	moveSiteFooterBelowPagination();
	// Starlight may re-render the frame during view transitions.
	document.addEventListener('astro:after-swap', moveSiteFooterBelowPagination);
</script>

<style>
	@layer starlight.components {
		.site-footer {
			margin-top: 2.5rem;
			padding: 1.25rem 0 0.25rem;
			border-top: 1px solid var(--ledger-hairline);
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}

		.site-footer p {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			justify-content: space-between;
			gap: 0.5rem 0.75rem;
			margin: 0;
		}

		.site-footer-credit {
			display: flex;
			align-items: baseline;
			gap: 0.25rem;
			margin-inline-start: auto;
		}

		.credit-ink {
			color: var(--ledger-ink);
		}

		.site-footer-credit a {
			color: var(--ledger-ink);
			font-weight: 600;
		}

		.site-footer a {
			color: var(--sl-color-gray-3);
			text-decoration-color: var(--ledger-hairline);
			text-underline-offset: 3px;
		}

		.site-footer a:hover {
			color: var(--sl-color-accent);
			text-decoration-color: var(--sl-color-accent);
		}
	}
</style>
